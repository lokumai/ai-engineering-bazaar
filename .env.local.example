# §14 — Supabase. Copy to .env.local and fill in. .env.local is gitignored.
#
# The two NEXT_PUBLIC_* values are compiled into the browser bundle and are
# PUBLIC BY DESIGN (§14.10): the security boundary is row-level security in
# Postgres, not the key. Never "fix" them into secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# §14.1 — the kill switch. Accounts stay OFF until bazaar.lokumai.com is live,
# because the shared lokumai.github.io origin exposes the session token to any
# sibling project site published under it. Flip to true only after DNS.
NEXT_PUBLIC_AUTH_ENABLED=false

# ── Local development and CI only. NEVER shipped to the browser, never a
# ── NEXT_PUBLIC_ variable, never added to a GitHub Actions secret used by the
# ── deploy workflow.

# Applying migrations and running the RLS test suite.
SUPABASE_DB_URL=

# Seeding test users for the Playwright run. Bypasses RLS entirely — this is
# why §14.10 forbids it from ever reaching Metabase or the browser.
SUPABASE_SERVICE_ROLE_KEY=
