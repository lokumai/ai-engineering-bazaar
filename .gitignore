# Written by `npm run prebuild` from the figures in mini-courses/.
public/course-images/

# Playwright
test-results/
playwright-report/

# Caravan's pipeline runs (.claude/skills/caravan-trends/): raw responses and
# working files, reproducible from the frozen queries. What a run keeps is the
# diff to mini-courses/caravan/ and its PROGRESS entry.
.caravan/

# Playwright MCP session artifacts (console logs, page snapshots)
.playwright-mcp/
docs/superpowers/

# A loose file holding a Supabase personal access token. Ignored because it
# exists: removing this line once staged the token itself, and the only thing
# that caught it was a grep over the staged diff.
supabase-access-tokens

# Supabase CLI working state. The schema in supabase/migrations/ IS committed —
# it is the whole of §14.2 and §14.4 and nothing else describes them.
supabase/.temp/
supabase/.branches/

# Intellica's program documents: the plan, the kick-off email, the guide and its PDFs, screenshots and the
# guide video. They stay local because this repository is public. Listed one by one, not docs/ as a whole,
# so a human-facing document added later is not ignored by accident.
/docs/PROGRAM.md
/docs/OVERVIEW.md
/docs/EMAIL-1.md
/docs/EMAIL-1.pdf
/docs/GUIDE.md
/docs/GUIDE-EN.pdf
/docs/REHBER-TR.pdf
/docs/images/
/docs/video/
